---
layout: base.njk
pagination:
  data: subjects
  size: 1
  alias: s
permalink: "{{ s.file }}"
eleventyComputed:
  title: "{{ s.name | safe }}{{ t.titleSep | safe }}{{ site.title | safe }}"
  alternate: "{{ s.vocab | safe }}"
  path: "{{ s.path | safe }}"
  description: "{{ s.summary | safe }}"
  schema: ""
---
{%- from "texts.njk" import texts %}
<h1>{{ s.name }}</h1>
{{ texts(s.titles) }}
{{- texts(s.descriptions) }}
<dl>
<dt>{{ t.version }}</dt><dd>{{ s.version }}</dd>
<dt>@context</dt><dd><a href="{{ s.contextAlias }}">{{ s.contextAlias }}</a>{{ t.open }}{{ t.exactVersion }}<a href="{{ s.contextExact }}">{{ s.contextExact }}</a>{{ t.close }}</dd>
<dt>{{ t.vocabulary }}</dt><dd><a href="{{ s.vocab }}">{{ s.vocab }}</a></dd>
<dt>{{ t.namespace }}</dt><dd>{{ s.namespace }}</dd>
</dl>
<h2>{{ t.models }}</h2>
<ul>
{%- for m in s.models %}
<li><a href="{{ m.page }}">{{ m.type }}</a>{{ t.open }}{{ m.kind }}{{ t.comma }}{{ m.status }}{{ t.close }}{% for x in m.titles %} <span lang="{{ x.lang }}">{{ x.text }}</span>{% endfor %}</li>
{%- endfor %}
</ul>
<h2>{{ t.terms }}</h2>
<p>{{ t.termsIntro }}</p>
<dl>
{%- for x in s.terms %}
<dt id="{{ x.anchor }}"><a href="{{ x.page }}">{{ x.name }}</a></dt>
<dd>{{ x.what }}{{ t.period }} IRI: {{ x.iri }}{% for y in x.texts %}<br><span lang="{{ y.lang }}">{{ y.text }}</span>{% endfor %}</dd>
{%- endfor %}
</dl>
