---js
{
  layout: "base.njk",
  // Only for a node with adapter files.
  eleventyComputed: {
    permalink: (data) => (data.hasAdapterFiles ? "adapters/index.html" : false),
    title: (data) => `${data.t.adapters}${data.t.titleSep}${data.site.title}`,
    description: (data) => data.t.adaptersIntro,
    path: "adapters/",
    schema: "",
  },
}
---
{#- What each adapter's file is, how to use it and where to get it; the files themselves are on the model pages. #}
<h1>{{ t.adapters }}</h1>
<p>{{ t.adaptersIntro }}</p>
<ul>
{%- for r in t.adaptersRules %}
<li>{{ r }}</li>
{%- endfor %}
</ul>
{%- for a in adapters %}
{%- set get = t.adapterGetText(a.name) %}
<h2 id="{{ a.name }}" lang="{{ a.label.lang }}">{{ a.label.text }}</h2>
<dl>
{%- if a.note %}
<dt>{{ t.adapterWhat }}</dt><dd lang="{{ a.note.lang }}">{{ a.note.text }}</dd>
{%- endif %}
{%- if a.use %}
<dt>{{ t.adapterUse }}</dt><dd lang="{{ a.use.lang }}">{{ a.use.text }}</dd>
{%- endif %}
<dt>{{ t.adapterGet }}</dt><dd>{{ get[0] }}<a href="{{ t.exportGuideUrl }}">{{ t.exportGuide }}</a>{{ get[1] }}</dd>
</dl>
{%- endfor %}
