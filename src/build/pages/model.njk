---
layout: base.njk
pagination:
  data: models
  size: 1
  alias: m
permalink: "{{ m.file }}"
eleventyComputed:
  title: "{{ m.type | safe }}{{ t.titleSep | safe }}{{ site.title | safe }}"
  path: "{{ m.path | safe }}"
  description: "{{ m.summary | safe }}"
  schema: "{{ m.schema | safe }}"
---
{%- from "texts.njk" import texts %}
<p><a href="{{ m.subject.page }}">{{ m.subject.name }}</a></p>
<h1 id="{{ m.type }}">{{ m.type }}</h1>
{{ texts(m.titles) }}
{{- texts(m.descriptions) }}
<dl>
<dt>{{ t.stage }}</dt><dd>{{ m.status }}</dd>
<dt>{{ t.kind }}</dt><dd>{{ m.kind }}</dd>
<dt>{{ t.typeIri }}</dt><dd>{{ m.typeIri }}</dd>
{%- if m.subClassOf %}
<dt>{{ t.subclassOf }}</dt><dd><a href="{{ m.subClassOf }}">{{ m.subClassOf }}</a></dd>
{%- endif %}
{%- if m.aliasOf %}
<dt>{{ t.aliasOf }}</dt><dd><a href="{{ m.aliasOf }}">{{ m.aliasOf }}</a></dd>
{%- endif %}
{%- for e in m.extends %}
<dt>{{ t.extendsLabel }}</dt><dd><a href="{{ e.typeIri }}">{{ e.typeIri }}</a> v{{ e.version }}{{ t.open }}<a href="{{ e.index }}">{{ t.index }}</a>{{ t.close }}</dd>
{%- endfor %}
<dt>JSON Schema</dt><dd><a href="{{ m.schema }}">{{ m.schema }}</a></dd>
<dt>@context</dt><dd><a href="{{ m.context }}">{{ m.context }}</a></dd>
{%- for x in m.examples %}
<dt>{{ t.example }}</dt><dd><a href="{{ x }}">{{ x }}</a></dd>
{%- endfor %}
{%- if m.downloads.length %}
<dt>{{ t.downloads }}</dt><dd><span class="downloads">{% for f in m.downloads %}<a class="button" href="{{ f.url }}" download lang="{{ f.label.lang }}">{{ f.label.text }}</a> {% endfor %}</span><a href="{{ t.aboutFilesUrl }}">{{ t.aboutFiles }}</a></dd>
{%- endif %}
</dl>
<h2>{{ t.attributes }}</h2>
{%- for a in m.attributes %}
<h3 id="{{ a.name }}">{{ a.name }}</h3>
{{ texts(a.texts) }}
<p>{{ a.type or t.any }}{% if a.required %}{{ t.comma }}{{ t.required }}{% endif %}{{ t.period }} IRI: {{ a.iri }}</p>
{%- else %}
<p>{{ t.noAttributes }}</p>
{%- endfor %}
{%- if m.standards.length %}
<h2>{{ t.standards }}</h2>
<ul>
{%- for x in m.standards %}
<li>{% if x.url %}<a href="{{ x.url }}" lang="{{ x.name.lang }}">{{ x.name.text }}</a>{% else %}<span lang="{{ x.name.lang }}">{{ x.name.text }}</span>{% endif %}{{ t.open }}<a href="{{ x.mapping }}">{{ t.mapping }}</a>{{ t.close }}</li>
{%- endfor %}
</ul>
{%- endif %}
{%- if m.notes.length or m.history.length %}
<h2>{{ t.notes }}</h2>
{%- if m.notes.length %}
<ul>
{%- for n in m.notes %}
<li lang="{{ n[0].lang }}">{{ n[0].text }}</li>
{%- endfor %}
</ul>
{%- endif %}
{%- if m.history.length %}
<details id="history">
<summary>{{ t.history(m.history.length) }}</summary>
<ul>
{%- for n in m.history %}
<li lang="{{ n[0].lang }}">{{ n[0].text }}</li>
{%- endfor %}
</ul>
</details>
{%- endif %}
{%- endif %}
