---
layout: base.njk
pagination:
  data: models
  size: 1
  alias: m
permalink: "{{ m.file }}"
eleventyComputed:
  title: "{{ m.type | safe }}: data models by {{ site.name | safe }}"
---
{%- from "texts.njk" import texts %}
<p><a href="{{ m.subject.page }}">{{ m.subject.name }}</a></p>
<h1 id="{{ m.type }}">{{ m.type }}</h1>
{{ texts(m.titles) }}
{{- texts(m.descriptions) }}
<dl>
<dt>Stage</dt><dd>{{ m.status }}</dd>
<dt>Kind</dt><dd>{{ m.kind }}</dd>
<dt>Type IRI</dt><dd>{{ m.typeIri }}</dd>
{%- if m.subClassOf %}
<dt>Subclass of</dt><dd><a href="{{ m.subClassOf }}">{{ m.subClassOf }}</a></dd>
{%- endif %}
{%- if m.aliasOf %}
<dt>Another name for</dt><dd><a href="{{ m.aliasOf }}">{{ m.aliasOf }}</a></dd>
{%- endif %}
{%- for e in m.extends %}
<dt>Extends</dt><dd><a href="{{ e.typeIri }}">{{ e.typeIri }}</a> v{{ e.version }} (<a href="{{ e.index }}">index</a>)</dd>
{%- endfor %}
<dt>JSON Schema</dt><dd><a href="{{ m.schema }}">{{ m.schema }}</a></dd>
<dt>@context</dt><dd><a href="{{ m.context }}">{{ m.context }}</a></dd>
{%- for x in m.examples %}
<dt>Example</dt><dd><a href="{{ x }}">{{ x }}</a></dd>
{%- endfor %}
</dl>
<h2>Attributes</h2>
{%- for a in m.attributes %}
<h3 id="{{ a.name }}">{{ a.name }}</h3>
{{ texts(a.texts) }}
<p>{{ a.type or "any" }}{% if a.required %}, required{% endif %}. IRI: {{ a.iri }}</p>
{%- else %}
<p>None.</p>
{%- endfor %}
