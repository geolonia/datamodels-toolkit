---
layout: base.njk
permalink: index.html
eleventyComputed:
  title: "{{ site.title | safe }}"
  description: "{{ site.description | safe }}"
  path: ""
  schema: ""
---
{%- from "texts.njk" import texts %}
<h1>{{ site.title }}</h1>
{%- if site.about %}
<p>{{ site.about }}</p>
{%- endif %}
<p>{{ t.introBefore }}<a href="{{ site.catalog }}">catalog.json</a>{{ t.introAfter }}</p>
{%- for s in subjects %}
<h2><a href="{{ s.page }}">{{ s.name }}</a> v{{ s.version }}</h2>
{{ texts(s.titles) }}
{{- texts(s.descriptions) }}
<ul>
{%- for m in s.models %}
<li><a href="{{ m.page }}">{{ m.type }}</a>{{ t.open }}{{ m.status }}{{ t.close }}{% for x in m.titles %} <span lang="{{ x.lang }}">{{ x.text }}</span>{% endfor %}</li>
{%- endfor %}
</ul>
{%- endfor %}
