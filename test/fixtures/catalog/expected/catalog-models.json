    "version": "1.0.0",
    "status": "draft",
    "title": {
      "ja": "マイルストーン",
      "en": "Milestone"
    },
    "description": {
      "ja": "プロジェクトの中でタスクをまとめる予定の目標。Redmine のバージョン、GitHub や GitLab のマイルストーン、Jira の修正バージョンなど。名前、期限、状態を持つ。",
      "en": "A planned target that groups tasks within a project: a version in Redmine, a milestone in GitHub or GitLab, a fix version in Jira. It has a name, a due date and a state."
    },
    "sampleProperties": [
      "name",
      "description",
      "project",
      "start",
      "due",
      "milestoneStatus",
      "source",
      "externalId",
      "dateCreated",
      "dateModified"
    ],
    "pageUrl": "https://datamodels.jp/models/task/Milestone/",
    "pageUrlEn": "https://datamodels.jp/en/models/task/Milestone/",
    "exampleUrls": [
      "https://datamodels.jp/examples/task/Milestone/example-normalized.jsonld",
      "https://datamodels.jp/examples/task/Milestone/example.json"
    ],
    "mappingUrls": [
      "https://datamodels.jp/mapping/task/Milestone/github.yaml",
      "https://datamodels.jp/mapping/task/Milestone/redmine.yaml"
    ],
    "mappings": [
      {
        "url": "https://datamodels.jp/mapping/task/Milestone/github.yaml",
        "standard": {
          "ja": "GitHub のマイルストーン",
          "en": "GitHub milestone"
        }
      },
      {
        "url": "https://datamodels.jp/mapping/task/Milestone/redmine.yaml",
        "standard": {
          "ja": "Redmine のバージョン",
          "en": "Redmine version"
        }
      }
    ],
    "attributes": [
      {
        "name": "name",
        "iri": "https://uri.etsi.org/ngsi-ld/name",
        "ngsiType": "Property",
        "type": "string",
        "required": true,
        "description": {
          "ja": "名称",
          "en": "Name"
        }
      },
      {
        "name": "description",
        "iri": "http://purl.org/dc/terms/description",
        "ngsiType": "Property",
        "type": "string",
        "required": false,
        "description": {
          "ja": "説明",
          "en": "Description"
        }
      },
      {
        "name": "project",
        "iri": "https://datamodels.jp/ns/task/project",
        "ngsiType": "Relationship",
        "type": "string",
        "format": "uri",
        "target": "https://datamodels.jp/ns/task/Project",
        "required": false,
        "description": {
          "ja": "所属プロジェクト",
          "en": "The project this belongs to"
        }
      },
      {
        "name": "start",
        "iri": "https://datamodels.jp/ns/task/start",
        "ngsiType": "Property",
        "type": "string",
        "formats": [
          "date",
          "date-time"
        ],
        "required": false,
        "description": {
          "ja": "予定期間の開始。日付、または日時",
          "en": "Planned start: a date, or a date and time"
        }
      },
      {
        "name": "due",
        "iri": "https://datamodels.jp/ns/task/due",
        "ngsiType": "Property",
        "type": "string",
        "formats": [
          "date",
          "date-time"
        ],
        "required": false,
        "description": {
          "ja": "期限（予定したリリース・完了）。日付、または日時",
          "en": "Due: the planned release or completion, a date or a date and time"
        }
      },
      {
        "name": "milestoneStatus",
        "iri": "https://datamodels.jp/ns/task/milestoneStatus",
        "ngsiType": "Property",
        "type": "string",
        "enum": [
          "open",
          "locked",
          "closed"
        ],
        "required": false,
        "description": {
          "ja": "状態。open=受付中、locked=ロック中（新しいタスクを追加できない）、closed=完了。core context の status は予約語のため milestoneStatus",
          "en": "State: open = accepting tasks, locked = no new tasks may be added, closed = done; status is protected in the core context, hence milestoneStatus"
        }
      },
      {
        "name": "source",
        "iri": "https://smart-data-models.github.io/data-models/terms.jsonld#/definitions/source",
        "ngsiType": "Property",
        "type": "string",
        "format": "uri",
        "required": false,
        "description": {
          "ja": "元システムにおけるこのオブジェクトの URL",
          "en": "URL of this object in the system of record"
        }
      },
      {
        "name": "externalId",
        "iri": "https://datamodels.jp/ns/task/externalId",
        "ngsiType": "Property",
        "type": "string",
        "required": false,
        "description": {
          "ja": "元システムにおける識別子",
          "en": "Identifier in the system of record"
        }
      },
      {
        "name": "dateCreated",
        "iri": "https://smart-data-models.github.io/data-models/terms.jsonld#/definitions/dateCreated",
        "ngsiType": "Property",
        "type": "string",
        "format": "date-time",
        "required": false,
        "description": {
          "ja": "元システムでの作成日時（ブローカーの createdAt とは別）",
          "en": "Creation time in the system of record (distinct from the broker attribute createdAt)"
        }
      },
      {
        "name": "dateModified",
        "iri": "https://smart-data-models.github.io/data-models/terms.jsonld#/definitions/dateModified",
        "ngsiType": "Property",
        "type": "string",
        "format": "date-time",
        "required": false,
        "description": {
          "ja": "元システムでの更新日時",
          "en": "Last modification time in the system of record"
        }
      }
    ],
    "adapters": {
      "geonicdb": "https://datamodels.jp/adapters/geonicdb/task/Milestone.json"
    }
  },
